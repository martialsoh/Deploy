# .env - Extend with app-specific variables

HOSTNAME=myhost                      # Your server hostname (e.g. server01)
DOCKERDIR=/home/martial/docker      # Base Docker directory
USER_MARTIAL=martial                # User to own files and volumes

# PostgreSQL
POSTGRES_USER=postgres_user

# MariaDB
MARIADB_ROOT_USERNAME=root

# Traefik
TRAEFIK_EMAIL=youremail@example.com
TRAEFIK_BASIC_AUTH_USER=traefikuser

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin

# N8N
N8N_DB_NAME=n8n_db
N8N_DB_USER=n8n_user

# Authentik
AUTHENTIK_DB_USER=authentik_db_user

# Additional app ports or settings can go here...

---------------------------------
version: "3.8"

services:
  redis:
    image: redis:7
    container_name: redis
    volumes:
      - ${DOCKERDIR}/appdata/redis:/data
    networks:
      - default
---------------------------------
version: "3.8"

services:
  postgresql:
    image: postgres:15
    container_name: postgresql
    environment:
      - POSTGRES_PASSWORD_FILE=/run/secrets/postgres_default_password
      - POSTGRES_USER=postgres_user
    secrets:
      - postgres_default_password
    volumes:
      - ${DOCKERDIR}/appdata/postgresql:/var/lib/postgresql/data
    networks:
      - default

secrets:
  postgres_default_password:
    external: true

networks:
  default:
    external: false


--------------------------------
version: "3.8"

services:
  mariadb:
    image: mariadb:10.11
    container_name: mariadb
    environment:
      - MYSQL_ROOT_PASSWORD_FILE=/run/secrets/mariadb_root_password
      - MYSQL_ROOT_USER=${MARIADB_ROOT_USERNAME}
    secrets:
      - mariadb_root_password
    volumes:
      - ${DOCKERDIR}/appdata/mariadb:/var/lib/mysql
    networks:
      - default
    restart: unless-stopped

secrets:
  mariadb_root_password:
    external: true

networks:
  default:
    external: false

-----------------------------
version: "3.8"

services:
  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    environment:
      - ROCKET_PORT=80
      - WEBSOCKET_ENABLED=true
    volumes:
      - ${DOCKERDIR}/appdata/vaultwarden:/data
    ports:
      - "8081:80"
    networks:
      - default
    restart: unless-stopped

-------------------
version: "3.8"

services:
  jellyfin:
    image: jellyfin/jellyfin:latest
    container_name: jellyfin
    environment:
      - TZ=Etc/UTC
    volumes:
      - ${DOCKERDIR}/appdata/jellyfin/config:/config
      - ${DOCKERDIR}/media:/media
    ports:
      - "8096:8096"
    networks:
      - default
    restart: unless-stopped

-------------------------------
version: "3.8"

services:
  n8n:
    image: n8nio/n8n:latest
    container_name: n8n
    environment:
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgresql
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_DATABASE=${N8N_DB_NAME}
      - DB_POSTGRESDB_USER=${N8N_DB_USER}
      - DB_POSTGRESDB_PASSWORD_FILE=/run/secrets/n8n_postgres_password
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=${USER_MARTIAL}
      - N8N_BASIC_AUTH_PASSWORD_FILE=/run/secrets/n8n_postgres_password
    secrets:
      - n8n_postgres_password
    depends_on:
      - postgresql
    ports:
      - "5678:5678"
    volumes:
      - ${DOCKERDIR}/appdata/n8n:/home/node/.n8n
    networks:
      - default
    restart: unless-stopped

secrets:
  n8n_postgres_password:
    external: true

-------------------------------
version: "3.8"

services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ${DOCKERDIR}/appdata/prometheus:/etc/prometheus
      - ${DOCKERDIR}/prometheus_data:/prometheus
    ports:
      - "9090:9090"
    networks:
      - default
    restart: unless-stopped

-------------------------------

version: "3.8"

services:
  nextcloud:
    image: nextcloud:latest
    container_name: nextcloud
    environment:
      - MYSQL_PASSWORD_FILE=/run/secrets/mariadb_root_password
      - ADMIN_PASSWORD_FILE=/run/secrets/nextcloud_admin_password
    secrets:
      - mariadb_root_password
      - nextcloud_admin_password
    volumes:
      - ${DOCKERDIR}/appdata/nextcloud:/var/www/html
    networks:
      - t3_proxy
    ports:
      - "8080:80"

secrets:
  mariadb_root_password:
    external: true
  nextcloud_admin_password:
    external: true

networks:
  t3_proxy:
    external: true
